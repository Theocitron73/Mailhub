{
  "name": "mailhub",
  "version": "1.0.0",
  "description": "MailHub - messagerie multi-comptes IMAP avec tri automatique",
  "main": "main.js",
  "author": "MailHub",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Theocitron73/Mailhub.git"
  },
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "build": "node -e \"console.log('Build complete')\"",
    "lint": "node -c server.js && node -c renderer/mailhub-web.js",
    "test": "node test/rules.test.js && node test/thunderbird.test.js && node test/rulesio.test.js && node test/signature.test.js && node test/attachment.test.js",
    "dist:win": "electron-builder --win --x64 --publish never && node scripts/generate-manifest.js",
    "dist:mac": "electron-builder --mac --universal --publish never",
    "dist": "electron-builder --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "express": "^5.3.0",
    "imapflow": "^1.0.164",
    "mailparser": "^3.7.1",
    "nodemailer": "^6.9.14"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.mailhub.app",
    "productName": "MailHub",
    "copyright": "Copyright © 2026 MailHub",
    "publish": [
      {
        "provider": "github",
        "owner": "Theocitron73",
        "repo": "Mailhub"
      }
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MailHub",
      "artifactName": "MailHub-Setup-${version}.${ext}"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": ["universal"]
        }
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "MailHub-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "MailHub ${version}"
    }
  }
}
