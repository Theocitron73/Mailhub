<?xml version="1.0" encoding="utf-8"?>
<!-- Pas de sauvegarde ni de transfert des données de MailHub : les mots de passe sont chiffrés
     avec une clé propre à ce téléphone (Keystore), inutilisable ailleurs. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
